{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "type": "stat",
      "title": "Total Log Lines (1 Hour)",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-ds" },
          "expr": "sum(count_over_time({service=~\".+\"}[1h]))",
          "queryType": "range",
          "refId": "A",
          "legendFormat": "Logs"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Active Microservices & Containers",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-ds" },
          "expr": "count(sum by (service) (count_over_time({service=~\".+\"}[1h])))",
          "queryType": "range",
          "refId": "A",
          "legendFormat": "Services"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Log Throughput Rate per Service",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-ds" },
          "expr": "sum(rate({service=~\".+\"}[1m])) by (service)",
          "queryType": "range",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Live Microservices REST & SQL Stream Logs",
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 4 },
      "id": 4,
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-ds" },
          "expr": "{service=~\".+\"}",
          "queryType": "range",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "showCommonLabels": true,
        "showTime": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["job-intelligence", "loki", "logs"],
  "time": { "from": "now-24h", "to": "now" },
  "title": "Loki Microservice Log Explorer",
  "uid": "job-intel-loki-explorer"
}
