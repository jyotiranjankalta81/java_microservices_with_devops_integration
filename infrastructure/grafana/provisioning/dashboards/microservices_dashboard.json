{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Total HTTP Requests",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "expr": "sum(http_server_requests_seconds_count)",
          "legendFormat": "Requests"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests Rate per Service",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 0 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (job)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM Heap Used Memory (Bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HikariCP Active DB Connections",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 4,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "expr": "hikaricp_connections_active",
          "legendFormat": "{{job}} - {{pool}}"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Live Microservices Stream Logs (Grafana Loki)",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 14 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-ds" },
          "expr": "{service=~\".+\"}",
          "queryType": "range",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "showCommonLabels": true,
        "showTime": true
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["job-intelligence", "microservices"],
  "time": { "from": "now-15m", "to": "now" },
  "title": "Job Intelligence Microservices Dashboard",
  "uid": "job-intel-main"
}
