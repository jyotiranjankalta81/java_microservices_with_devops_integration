# Copy to .env and adjust for local development.
# Docker Compose reads .env automatically for ${VAR} substitution.

JWT_SECRET=change-me-in-production-use-256-bit-secret-key-minimum!!

# Gateway -> job-service routing
# Docker mode:  http://job-service:8082
# Local debug:  http://host.docker.internal:8082
JOB_SERVICE_URL=http://job-service:8082

SPRING_PROFILES_ACTIVE=dev

AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass
JOB_DB_USER=job_user
JOB_DB_PASSWORD=job_pass
DASHBOARD_DB_USER=dashboard_user
DASHBOARD_DB_PASSWORD=dashboard_pass
EXPORT_DB_USER=export_user
EXPORT_DB_PASSWORD=export_pass
AUDIT_DB_USER=audit_user
AUDIT_DB_PASSWORD=audit_pass
